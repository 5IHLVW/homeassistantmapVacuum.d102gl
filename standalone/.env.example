# ---- Compte Xiaomi (Mi Home) : obligatoire, la carte est stockée dans le cloud Xiaomi ----
XIAOMI_USERNAME=
XIAOMI_PASSWORD=
# Serveur du compte : cn, de (Europe), us, ru, tw, sg, in, i2 (Inde). Laisser vide = recherche sur tous les serveurs.
XIAOMI_SERVER=de

# ---- Robot ----
# Token de l'appareil (32 caractères hexadécimaux). Sert à identifier le robot et à lui parler en local.
# Laisser vide : le robot est choisi automatiquement s'il n'y en a qu'un sur le compte (python run.py --devices pour voir la liste).
VACUUM_TOKEN=
# Identifiant de l'appareil (did) - alternative au token pour choisir le robot.
VACUUM_DEVICE_ID=
# Adresse IP locale du robot (optionnel, sinon celle connue du cloud est utilisée).
VACUUM_HOST=
# API du constructeur : auto, roborock, dreame, viomi, roidmi, ijai, xiaomi
VACUUM_API=auto

# ---- Affichage ----
MAP_REFRESH_SECONDS=30
MAP_SCALE=3
MAP_ROTATE=0
# Thème : clair (fond blanc, pièces pastel), contraste (fond blanc, couleurs franches), original (fond bleu d'origine)
MAP_THEME=clair
# Couleur du fond (#RRGGBB). Vide = blanc (ou bleu avec le thème original).
MAP_BACKGROUND=
# Couleurs des pièces, dans l'ordre des numéros de pièce, séparées par des espaces. Vide = couleurs du thème.
# Exemple : MAP_ROOM_COLORS=#F4A9A3 #A7C8F2 #BFE3A1 #D2B7EE #F8CF96
MAP_ROOM_COLORS=
# Trait de séparation entre deux pièces voisines, et sa couleur (vide = couleur du thème).
MAP_ROOM_BORDERS=true
MAP_BORDER_COLOR=
SAVE_MAPS=true

# ---- Serveur web ----
WEB_HOST=127.0.0.1
WEB_PORT=5000
